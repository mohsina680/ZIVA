# Use Ollama by default. For LM Studio, change base URL to http://localhost:1234/v1
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=ollama

# Recommended local reasoning model for your laptop
TEXT_MODEL=qwen3:4b-thinking

# Local embedding model for RAG. First run downloads the model.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Project folders
RUNBOOK_DIR=runbooks
KNOWLEDGE_DIR=data/docs
WORKSPACE_DIR=workspace
LOG_DIR=logs
VECTOR_DB_DIR=storage/faiss_index

# Scope lock: only these task types are allowed
TASK_SCOPE=documentation,coding,web_design

# Safety/output behavior
SAVE_RAW_MODEL_OUTPUT=true
EXTRACT_FILE_BLOCKS=true
